{
  "$schema": "https://json-schema.boschrexroth.com/ctrlx-automation/ctrlx-core/apps/package-manifest/package-manifest.v1.4.schema.json",
  "version": "1.0.0",
  "id": "amr-map",
  "services": {
    "proxyMapping": [
      {
        "name": "amr-map",
        "url": "/amr-map",
        "binding": "unix://{$SNAP_DATA}/package-run/amr-map/web.sock",
        "restricted": []
      }
    ]
  },
  "menus": {
    "sidebar": [
      {
        "id": "amr-map",
        "target": "_blank",
        "title": "AMR Map",
        "icon": "bosch-ic-worldwideweb",
        "link": "/amr-map?token=${bearertoken}"
      }
    ],
    "settings": [],
    "overview": [
      {
        "id": "amr-map",
        "title": "AMR Map",
        "icon": "bosch-ic-worldwideweb",
        "link": "/amr-map?token=${bearertoken}"
      }
    ]
  }
}